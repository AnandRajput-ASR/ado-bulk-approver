# Azure DevOps Personal Access Token
# Required scopes: Code (Read & Write)
# Generate at: https://dev.azure.com/{your-org}/_usersSettings/tokens

# Default profile (used when no --profile flag is passed)
AZURE_DEVOPS_PAT=your_personal_access_token_here

# Named profiles — use with: python approve_prs.py --profile work
# AZURE_DEVOPS_PAT_WORK=your_work_token_here
# AZURE_DEVOPS_PAT_CLIENT=your_client_token_here
